{
    "name": "spryker-eco/algolia",
    "type": "library",
    "description": "Algolia module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "algolia/algoliasearch-client-php": "^3.4.2",
        "spryker/kernel": "^3.76.0",
        "spryker/log": "^3.18.0",
        "spryker/product": "^6.53.0",
        "spryker/product-category": "^4.28.1",
        "spryker/product-image": "^3.20.0",
        "spryker/transfer": "^3.42.0",
        "symfony/cache": "^6.4 || ^7.4",
        "symfony/console": "^6.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "spryker/code-sniffer": "^0.17.30",
        "spryker/testify": "^3.62.0"
    },
    "suggest": {
        "spryker/product-review": "Required for Product search functionality.",
        "spryker/price-product": "Optional for Product search functionality.",
        "spryker/merchant-product": "Optional for Product search functionality.",
        "spryker/merchant-product-offer": "Optional for Product search functionality."
    },
    "autoload": {
        "psr-4": {
            "SprykerEco\\": "src/SprykerEco/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerEcoTest\\": "tests/SprykerEcoTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "vendor/bin/phpcs -p -s src/ tests/",
        "cs-fix": "vendor/bin/phpcbf -p src/ tests/",
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/codecept build && vendor/bin/codecept run"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}

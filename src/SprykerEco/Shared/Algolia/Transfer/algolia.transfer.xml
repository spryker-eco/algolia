<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="AlgoliaConfig" strict="true">
        <property name="isActive" type="bool"/>
        <property name="tenantIdentifier" type="string"/>
        <property name="applicationId" type="string"/>
        <property name="adminApiKey" type="string"/>
        <property name="searchOnlyApiKey" type="string"/>
        <property name="isSearchInFrontendEnabledForProducts" type="bool" description="if true, Algolia search will be enabled for products"/>
        <property name="isProductPriceSynced" type="bool"/>
        <property name="isPersonalizationEnabled" type="bool"/>
        <property name="enabledFeatures" type="string[]" singular="enabledFeature" description="list of Algolia features supported by provided applicationId (auto-populated values)"/>
        <property name="isSearchInFrontendEnabledForCmsPages" type="bool" description="if true, Algolia search will be enabled for CMS pages"/>
        <property name="isIndexMappingEnabled" type="bool" description="if true, Algolia index mapping will be enabled"/>
        <property name="entityToIndexMappings" type="EntityToIndexMapping[]" description="mapping rules"/>
    </transfer>

    <transfer name="EntityToIndexMapping">
        <property name="sourceIdentifier" type="string" description="Name of the resource to be indexed."/>
        <property name="store" type="string" description="Name of Spryker store, can be *"/>
        <property name="locales" type="string[]" description="List of locales to be used for this entity, can be *" singular="locale"/>
        <property name="indexName" type="string" description="Name of the Algolia index to be used for this entity"/>
    </transfer>

    <transfer name="AlgoliaConfigResponse">
        <property name="isSuccessful" type="bool"/>
        <property name="errorMessages" type="array" singular="errorMessage"/>
    </transfer>

    <transfer name="HttpRequest">
        <property name="headers" type="array" singular="header" associative="true"/>
    </transfer>

    <transfer name="ProductDeleted">
        <property name="sku" type="string"/>
    </transfer>

     <transfer name="AlgoliaResponse">
        <property name="isSuccessful" type="bool"/>
        <property name="responseMessage" type="string"/>
    </transfer>

    <transfer name="AlgoliaSearchResponse">
        <property name="searchResults" type="array"/>
        <property name="isSuccessful" type="bool"/>
        <property name="responseMessage" type="string"/>
    </transfer>

    <transfer name="SearchQuery">
        <property name="store" type="string" strict="true"/>
    </transfer>

    <transfer name="ProductConcrete">
        <property name="sku" type="string"/>
        <property name="abstractSku" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="approvalStatus" type="string"/>
        <property name="name" type="string"/>
        <property name="attributes" type="array" associative="true" singular="attribute"/>
        <property name="imageSets" type="ProductImageSet[]" singular="imageSet"/>
        <property name="localizedAttributes" type="LocalizedAttributes[]" singular="localizedAttributes"/>
        <property name="abstractLocalizedAttributes" type="LocalizedAttributes[]" singular="abstractLocalizedAttributes"/>
        <property name="stores" type="Store[]" singular="stores"/>
        <property name="prices" type="PriceProduct[]" singular="price"/>
        <property name="productAbstractPrices" type="PriceProduct[]" singular="productAbstractPrice"/>
        <property name="url" type="ProductUrl"/>
        <property name="rating" type="float"/>
        <property name="offers" type="ProductOffer[]" singular="offer"/>
        <property name="productLabels" type="ProductLabel[]" singular="productLabel"/>
        <property name="relatedCategoryTreeNodes" type="Node[]" singular="relatedCategoryTreeNode"/>
        <property name="searchMetadata" type="array" associative="true"/>
    </transfer>

    <transfer name="ProductAlternativeCreateRequest">
    </transfer>

    <transfer name="ProductBundle">
        <property name="availability" type="decimal"/>
        <property name="isNeverOutOfStock" type="bool"/>
        <property name="bundlesToRemove" type="array" singular="bundleToRemove"/>
        <property name="bundledProducts" type="ProductForBundle[]" singular="bundledProduct"/>
    </transfer>

    <transfer name="ProductForBundle">
        <property name="sku" type="string"/>
        <property name="bundleSku" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="quantity" type="int"/>
    </transfer>

    <transfer name="ProductDiscontinued">
        <property name="sku" type="string"/>
        <property name="activeUntil" type="string"/>
        <property name="discontinuedOn" type="string"/>
        <property name="productDiscontinuedNotes" type="ProductDiscontinuedNote[]" singular="productDiscontinuedNote"/>
    </transfer>

    <transfer name="ProductDiscontinuedNote">
        <property name="note" type="string"/>
    </transfer>

    <transfer name="ProductMeasurementUnit">
        <property name="name" type="string"/>
        <property name="code" type="string"/>
        <property name="defaultPrecision" type="int"/>
    </transfer>

    <transfer name="ProductOfferStock">
        <property name="quantity" type="decimal"/>
        <property name="stock" type="Stock"/>
        <property name="isNeverOutOfStock" type="bool"/>
        <property name="productOfferReference" type="string"/>
    </transfer>

    <transfer name="Company">
        <property name="isActive" type="bool"/>
        <property name="name" type="string"/>
        <property name="uuid" type="string"/>
        <property name="status" type="string"/>
        <property name="storeRelation" type="StoreRelation"/>
    </transfer>

    <transfer name="StoreRelation">
        <property name="idEntity" type="int"/>
        <property name="idStores" type="int[]" singular="idStores"/>
        <property name="stores" type="Store[]" singular="stores"/>
    </transfer>

    <transfer name="ProductImageSet">
        <property name="productImageSetKey" type="string"/>
        <property name="name" type="string"/>
        <property name="locale" type="Locale"/>
        <property name="productImages" type="ProductImage[]" singular="productImage"/>
    </transfer>

    <transfer name="ProductImage">
        <property name="externalUrlLarge" type="string"/>
        <property name="externalUrlSmall" type="string"/>
        <property name="sortOrder" type="int"/>
    </transfer>

    <transfer name="Locale">
        <property name="localeName" type="string"/>
        <property name="name" type="string"/>
        <property name="isActive" type="bool"/>
    </transfer>

    <transfer name="LocalizedAttributes">
        <property name="name" type="string"/>
        <property name="description" type="string"/>
        <property name="metaTitle" type="string"/>
        <property name="metaDescription" type="string"/>
        <property name="metaKeywords" type="string"/>
        <property name="isSearchable" type="bool"/>
        <property name="locale" type="Locale"/>
        <property name="attributes" type="array" associative="true" singular="attribute"/>
    </transfer>

    <transfer name="CompanySupplier">
        <property name="isActive" type="bool"/>
        <property name="key" type="string"/>
        <property name="name" type="string"/>
        <property name="status" type="string"/>
        <property name="uuid" type="string"/>
        <property name="companyType" type="string"/>
    </transfer>

    <transfer name="ProductUrl">
        <property name="abstractSku" type="string"/>
        <property name="urls" type="LocalizedUrl[]" singular="url"/>
    </transfer>

    <transfer name="LocalizedUrl">
        <property name="url" type="string"/>
        <property name="locale" type="Locale"/>
    </transfer>

    <transfer name="Store">
        <property name="name" type="string"/>
        <property name="selectedCurrencyIsoCode" type="string"/>
        <property name="defaultCurrencyIsoCode" type="string"/>
        <property name="availableCurrencyIsoCodes" type="array"/>
        <property name="availableLocaleIsoCodes" type="array"/>
        <property name="queuePools" type="array"/>
        <property name="storesWithSharedPersistence" type="array"/>
        <property name="countries" type="array"/>
        <property name="timezone" type="string"/>
    </transfer>

    <transfer name="PriceProduct">
        <property name="idPriceProduct" type="int"/>
        <property name="skuProduct" type="string"/>
        <property name="isActive" type="string"/>
        <property name="skuProductAbstract" type="string"/>
        <property name="priceNameType" type="string"/>
        <property name="groupKey" type="string"/>
        <property name="isMergeable" type="bool"/>
        <property name="concreteSku" type="string"/>
        <property name="volumeQuantity" type="int"/>
        <property name="priceDimension" type="PriceProductDimension"/>
        <property name="moneyValue" type="MoneyValue"/>
        <property name="priceType" type="PriceType"/>
    </transfer>

    <transfer name="PriceProductDimension">
        <property name="name" type="string"/>
    </transfer>

    <transfer name="MoneyValue">
        <property name="netAmount" type="int"/>
        <property name="grossAmount" type="int"/>
        <property name="priceData" type="string"/>
        <property name="priceDataChecksum" type="string"/>
        <property name="priceDataByPriceType" type="array"/>
        <property name="currency" type="Currency"/>
        <property name="store" type="Store"/>
    </transfer>

    <transfer name="PriceType">
        <property name="name" type="string"/>
        <property name="priceModeConfiguration" type="string"/>
    </transfer>

    <transfer name="Currency">
        <property name="code" type="string"/>
        <property name="symbol" type="string"/>
        <property name="name" type="string"/>
        <property name="fractionDigits" type="int"/>
    </transfer>

    <transfer name="Stock">
        <property name="sku" type="string"/>
        <property name="isNeverOutOfStock" type="bool"/>
        <property name="stockType" type="string"/>
        <property name="quantity" type="string"/>
    </transfer>

    <transfer name="ProductCategory">
        <property name="productOrder" type="int"/>
        <property name="category" type="Category"/>
    </transfer>

    <transfer name="Category">
        <property name="categoryKey" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="isInMenu" type="bool"/>
        <property name="isClickable" type="bool"/>
        <property name="isSearchable" type="bool"/>
        <property name="name" type="string"/>
        <property name="url" type="string"/>
        <property name="imageName" type="string"/>
        <property name="categoryImageName" type="string"/>
        <property name="metaTitle" type="string"/>
        <property name="metaDescription" type="string"/>
        <property name="metaKeywords" type="string"/>
<!--        <property name="categoryNode" type="array" associative="true"/>-->
<!--        <property name="nodeCollection" type="array" associative="true"/>-->
<!--        <property name="parentCategoryNode" type="array" associative="true"/>-->
<!--        <property name="categoryTemplate" type="array" associative="true"/>-->
        <property name="storeRelation" type="StoreRelation"/>
        <property name="localizedAttributes" type="CategoryLocalizedAttributes[]" singular="localizedAttributes"/>
<!--        <property name="extraParents" type="array"/>-->
<!--        <property name="imageSets" type="array"/>-->
    </transfer>

    <transfer name="CategoryLocalizedAttributes">
        <property name="name" type="string"/>
        <property name="url" type="string"/>
        <property name="metaTitle" type="string"/>
        <property name="metaDescription" type="string"/>
        <property name="metaKeywords" type="string"/>
<!--        <property name="image" type="array" associative="true"/>-->
        <property name="locale" type="Locale"/>
    </transfer>

    <transfer name="ProductOffer">
        <property name="merchantReference" type="string"/>
        <property name="merchantSku" type="string"/>
        <property name="productOfferReference" type="string"/>
        <property name="approvalStatus" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="concreteSku" type="string"/>
        <property name="productAttributes" type="array"/>
        <property name="createdAt" type="string"/>
        <property name="updatedAt" type="string"/>
        <property name="merchantName" type="string"/>
        <property name="productOfferValidity" type="ProductOfferValidity"/>
        <property name="prices" type="PriceProduct[]" singular="price"/>
        <property name="stores" type="Store[]" singular="store"/>
        <property name="productImages" type="ProductImage[]" singular="productImage"/>
        <property name="productLocalizedAttributes" type="LocalizedAttributes[]" singular="productLocalizedAttribute"/>
        <property name="productOfferStocks" type="ProductOfferStock[]" singular="productOfferStock"/>
    </transfer>

    <transfer name="ProductOfferValidity">
        <property name="validTo" type="string"/>
        <property name="validFrom" type="string"/>
    </transfer>

    <transfer name="ProductLabel">
        <property name="name" type="string"/>
        <property name="isActive" type="bool"/>
        <property name="localizedAttributesCollection" type="ProductLabelLocalizedAttributes[]" singular="localizedAttributes"/>
    </transfer>

    <transfer name="ProductLabelLocalizedAttributes">
        <property name="name" type="string"/>
        <property name="locale" type="Locale"/>
    </transfer>

    <transfer name="Node">
        <property name="isRoot" type="bool"/>
        <property name="isMain" type="bool"/>
        <property name="childrenNodes" type="NodeCollection"/>
        <property name="category" type="Category"/>
    </transfer>

    <transfer name="NodeCollection">
        <property name="nodes" type="Node[]" singular="node"/>
    </transfer>


    <transfer name="AlgoliaProductCollection">
        <property name="algoliaProducts" type="AlgoliaProduct[]" singular="algoliaProduct"/>
    </transfer>

    <transfer name="IndexedAlgoliaProductCollection">
        <property name="indexName" type="string"/>
        <property name="locale" type="string"/>
        <property name="tenantIdentifier" type="string"/>
        <property name="algoliaProducts" type="AlgoliaProduct[]" singular="algoliaProduct"/>
    </transfer>

    <transfer name="AlgoliaProduct">
        <property name="object" type="AlgoliaProductObject"/>
        <property name="metadata" type="AlgoliaProductMetadata"/>
    </transfer>

    <transfer name="AlgoliaIndicesCollection">
        <property name="indices" type="AlgoliaIndex[]" singular="index"/>
    </transfer>

    <transfer name="AlgoliaIndex">
        <property name="name" type="string"/>
        <property name="isPrimary" type="bool"/>
    </transfer>

    <transfer name="AlgoliaProductObject">
        <property name="objectID" type="string"/>
        <property name="sku" type="string"/>
        <property name="name" type="string"/>
        <property name="abstractName" type="string"/>
        <property name="description" type="string"/>
        <property name="url" type="string"/>
        <property name="concretePrices" type="AlgoliaProductPrice[]" associative="true" singular="concretePrice"/>
        <property name="prices" type="AlgoliaProductPrice[]" associative="true" singular="price"/>
        <property name="productAbstractSku" type="string"/>
        <property name="rating" type="float"/>
        <property name="keywords" type="string"/>
        <property name="images" type="array" associative="true" singular="image"/>
<!-- naming for categories and labels is set to be singular to match default Spryker filter naming -->
        <property name="category" type="string[]"/>
        <property name="label" type="string[]"/>
        <property name="hierarchicalCategories" type="string[]"/>
        <property name="attributes" type="array" associative="true" singular="attribute"/>
        <property name="merchantName" type="string[]" singular="merchantName"/>
        <property name="merchantReference" type="string[]" singular="merchantReference"/>
        <property name="searchMetadata" type="array" associative="true"/>
    </transfer>

    <transfer name="AlgoliaProductPrice">
        <property name="gross" type="int"/>
        <property name="net" type="int"/>
    </transfer>

    <transfer name="AlgoliaProductMetadata">
        <property name="locale" type="string"/>
    </transfer>

    <transfer name="AlgoliaApiCredentialsValidation">
        <property name="isAccountIdValid" type="bool"/>
        <property name="isAdminApiKeyValid" type="bool"/>
        <property name="isSearchOnlyApiKeyValid" type="bool"/>
    </transfer>

    <transfer name="ErrorMessage">
        <property name="code" type="string"/>
        <property name="detail" type="string"/>
    </transfer>

    <transfer name="AlgoliaApiCredentials">
        <property name="applicationId" type="string"/>
        <property name="apiKey" type="string"/>
    </transfer>

    <transfer name="IndexConfigurationResponse">
        <property name="isSuccessful" type="bool"/>
        <property name="errorMessage" type="string"/>
    </transfer>

    <transfer name="IndexConfiguration">
        <property name="indexName" type="string"/>
        <property name="locale" type="string"/>
        <property name="algoliaConfig" type="AlgoliaConfig"/>
    </transfer>

    <transfer name="AlgoliaResponse">
        <property name="isSuccessful" type="bool"/>
    </transfer>

    <transfer name="PaginationEntry">
        <property name="page" type="int"/>
        <property name="hitsPerPage" type="int"/>
        <property name="offset" type="int"/>
        <property name="length" type="int"/>
    </transfer>

    <transfer name="SortingEntry">
        <property name="field" type="string"/>
        <property name="direction" type="string"/>
    </transfer>

    <transfer name="FacetParameters">
        <property name="from" type="int"/>
        <property name="to" type="int"/>
        <property name="values" type="string[]" singular="value"/>
    </transfer>

    <transfer name="FacetEntry">
        <property name="type" type="string"/>
        <property name="parameters" type="FacetParameters"/>
    </transfer>

    <transfer name="FacetCollection">
        <property name="facets" type="FacetEntry[]" associative="true" singular="facet"/>
    </transfer>

    <transfer name="SearchRequest" strict="true">
        <property name="storeName" type="string"/>
        <property name="query" type="string"/>
        <property name="facets" type="FacetCollection"/>
        <property name="sort" type="SortingEntry"/>
        <property name="pagination" type="PaginationEntry"/>
        <property name="locale" type="string"/>
        <property name="userToken" type="string"/>
        <property name="userIp" type="string"/>
        <property name="sourceIdentifier" type="string"/>
    </transfer>

    <transfer name="SearchResponse">
        <property name="isSuccessful" type="bool"/>
        <property name="statusCode" type="int"/>
        <property name="errors" type="GlueError[]" singular="error"/>
        <property name="items" type="array" singular="item"/>
        <property name="pagination" type="SearchResponsePagination"/>
        <property name="facets" type="array" singular="facet"/>
        <property name="queryId" type="string"/>
    </transfer>

    <transfer name="GlueError">
        <property name="status" type="int"/>
        <property name="code" type="string"/>
        <property name="message" type="string"/>
    </transfer>

    <transfer name="SearchResponseProduct">
        <property name="sku" type="string"/>
        <property name="productAbstractSku" type="string"/>
        <property name="name" type="string"/>
        <property name="abstractName" type="string"/>
        <property name="description" type="string"/>
        <property name="images" type="array" associative="true" singular="image"/>
        <property name="label" type="string[]" singular="label"/>
        <property name="attributes" type="SearchResponseProductAttribute[]" singular="attribute"/>
        <property name="merchantName" type="string[]" singular="merchantName"/>
        <property name="merchantReference" type="string[]" singular="merchantReference"/>
        <property name="keywords" type="string"/>
        <property name="url" type="string"/>
        <property name="rating" type="string"/>
        <property name="searchMetadata" type="array" associative="true"/>
        <property name="category" type="string[]" singular="category"/>
        <property name="prices" type="SearchResponseProductPrice[]" singular="price"/>
    </transfer>

    <transfer name="SearchResponseProductAttribute">
        <property name="name" type="string"/>
        <property name="value" type="string"/>
    </transfer>

    <transfer name="SearchResponseProductPrice">
        <property name="currency" type="string"/>
        <property name="priceGross" type="int"/>
        <property name="priceNet" type="int"/>
    </transfer>

    <transfer name="SearchResponsePagination">
        <property name="numFound" type="int"/>
        <property name="currentPage" type="int"/>
        <property name="currentItemsPerPage" type="int"/>
    </transfer>

    <transfer name="SearchResponseFacetHierarchicalCategories">
        <property name="categories" type="string"/>
    </transfer>

    <transfer name="SuggestionsSearchResponse">
        <property name="isSuccessful" type="bool"/>
        <property name="statusCode" type="int"/>
        <property name="errors" type="GlueError[]" singular="error"/>
        <property name="completions" type="string[]" singular="completion"/>
        <property name="matches" type="array" associative="true" singular="match"/>
        <property name="matchedItems" type="array" singular="matchedItem"/>
        <property name="categories" type="string[]" singular="category"/>
        <property name="matchedItemsBySourceIdentifiers" type="array" singular="matchedItemsBySourceIdentifier"/>
    </transfer>

    <transfer name="SuggestionsMatchesCollection">
        <property name="matches" type="array" associative="true" singular="match"/>
        <property name="matchedItems" type="array" singular="matchedItem"/>
        <property name="categories" type="array" singular="category"/>
    </transfer>

    <transfer name="CmsPagePublished" strict="true">
        <property name="id" type="int"/>
        <property name="cmsPage" type="CmsPage"/>
        <property name="createdAt" type="string"/>
        <property name="updatedAt" type="string"/>
        <property name="flattenedLocaleCmsPageDatum" type="array" singular="flattenedLocaleCmsPageData"/>
    </transfer>


    <transfer name="CmsPageUnpublished" strict="true">
        <property name="id" type="int"/>
    </transfer>

    <transfer name="CmsPage">
        <property name="isActive" type="string"/>
        <property name="isSearchable" type="bool"/>
        <property name="fkTemplate" type="int"/>
        <property name="templateName" type="string"/>
        <property name="fkPage" type="int"/>
        <property name="validFrom" type="string"/>
        <property name="validTo" type="string"/>
        <property name="pageAttributes" type="CmsPageAttributes[]" singular="pageAttribute"/>
        <property name="metaAttributes" type="CmsPageMetaAttributes[]" singular="metaAttribute"/>
        <property name="storeRelation" type="StoreRelation"/>
    </transfer>

    <transfer name="CmsPageAttributes">
        <property name="idCmsPageLocalizedAttributes" type="int"/>
        <property name="localeName" type="string"/>
        <property name="idCmsPage" type="int"/>
        <property name="fkLocale" type="int"/>
        <property name="name" type="string"/>
        <property name="url" type="string"/>
        <property name="urlPrefix" type="string"/>
    </transfer>

    <transfer name="CmsPageMetaAttributes">
        <property name="idCmsPageLocalizedAttributes" type="int"/>
        <property name="localeName" type="string"/>
        <property name="fkLocale" type="int"/>
        <property name="metaTitle" type="string"/>
        <property name="metaKeywords" type="string"/>
        <property name="metaDescription" type="string"/>
    </transfer>

    <transfer name="AlgoliaExportCriteria" strict="true">
        <property name="entityType" type="string"/>
        <property name="storeName" type="string"/>
        <property name="locale" type="string"/>
        <property name="chunkSize" type="int"/>
        <property name="isDryRun" type="bool"/>
    </transfer>

    <transfer name="AlgoliaExportResult" strict="true">
        <property name="entityType" type="string"/>
        <property name="totalCount" type="int"/>
        <property name="exportedCount" type="int"/>
        <property name="failedCount" type="int"/>
        <property name="isSuccessful" type="bool"/>
        <property name="messages" type="string[]" singular="message"/>
    </transfer>

</transfers>
